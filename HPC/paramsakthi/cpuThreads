#!/bin/bash
#SBATCH --job-name=heatCpuThreads
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --time=04:00:00
#SBATCH --output=logs/heatCpuThreads-%j.out

set -euo pipefail
HERE="${SATURN_HPC_DIR:-${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}}"
REPO="$(cd "$HERE/../.." && pwd)"
if [ -r "$HERE/envCpuRuntime" ]; then
  source "$HERE/envCpuRuntime"
else
  source "$HERE/envCpu"
fi

CASE="${CASE:-heatStrong128}"
BIN="${BIN:-$REPO/buildCPUHPC/saturnCFD}"
THREADS="${SLURM_CPUS_PER_TASK:-48}"
TAG="${CASE}-threads-${SLURM_JOB_ID:-manual}"
[ -x "$BIN" ] || {
  echo "error: missing binary $BIN"
  echo "       run ./cpuBuild (CPU) or ./gpuBuild (GPU) first"
  exit 1
}
[ -f "$HERE/cases/${CASE}.yaml" ] || {
  echo "error: missing case $HERE/cases/${CASE}.yaml"
  echo "       run python3 generateCases.py first"
  exit 1
}
mkdir -p "$HERE/logs" "$HERE/results/cpu"
RUN="$HERE/cases/run-${TAG}.yaml"
sed "s|^  prefix: .*|  prefix: $HERE/results/cpu/${TAG}|" \
  "$HERE/cases/${CASE}.yaml" > "$RUN"

export OMP_NUM_THREADS="$THREADS"
export OMP_PROC_BIND=close
export OMP_PLACES=cores
echo "case=$CASE ranks=1 threads=$THREADS"
"$BIN" -threads "$THREADS" "$RUN"
