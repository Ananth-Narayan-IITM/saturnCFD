#!/bin/bash
# Build the CUDA Heat binary (Kokkos CUDA + MPI) on a login node.
# No PETSc is needed for saturnHeat.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
source "$HERE/envGpu"

KOKKOS_VERSION="${KOKKOS_VERSION:-4.7.04}"
KOKKOS_SRC="${KOKKOS_SRC:-$HOME/.cache/saturnCFD/kokkos-$KOKKOS_VERSION}"
KOKKOS_BUILD="${KOKKOS_BUILD:-$HOME/.cache/saturnCFD/build-kokkos-cuda}"
KOKKOS_CUDA_ROOT="${KOKKOS_CUDA_ROOT:-$HOME/.local/kokkos-cuda-$KOKKOS_VERSION}"
BUILD_GPU="${BUILD_GPU:-$REPO/buildGPUHPC}"
JOBS="${BUILD_JOBS:-16}"

command -v cmake >/dev/null || {
  echo "error: cmake not found."
  echo "       on the login node: python3 -m pip install --user 'cmake>=3.24'"
  exit 1
}
command -v nvcc >/dev/null || {
  echo "error: nvcc not found after loading the nvhpc module"
  exit 1
}
command -v git >/dev/null || {
  echo "error: git not found; it is needed to fetch Kokkos/yaml-cpp/doctest"
  exit 1
}

kokkos_config() {
  for d in lib64 lib; do
    local f="$KOKKOS_CUDA_ROOT/$d/cmake/Kokkos/KokkosConfig.cmake"
    [ -f "$f" ] && return 0
  done
  return 1
}

if ! kokkos_config; then
  if [ ! -d "$KOKKOS_SRC" ]; then
    echo "== clone Kokkos $KOKKOS_VERSION =="
    mkdir -p "$(dirname "$KOKKOS_SRC")"
    git clone --depth 1 --branch "$KOKKOS_VERSION" \
      https://github.com/kokkos/kokkos.git "$KOKKOS_SRC"
  fi
  echo "== build Kokkos CUDA (A100 / SM80) =="
  cmake -S "$KOKKOS_SRC" -B "$KOKKOS_BUILD" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$KOKKOS_CUDA_ROOT" \
    -DCMAKE_CXX_COMPILER="$KOKKOS_SRC/bin/nvcc_wrapper" \
    -DCMAKE_CXX_STANDARD=20 \
    -DKokkos_ENABLE_CUDA=ON \
    -DKokkos_ENABLE_CUDA_LAMBDA=ON \
    -DKokkos_ENABLE_OPENMP=OFF \
    -DKokkos_ENABLE_SERIAL=ON \
    -DKokkos_ARCH_AMPERE80=ON \
    -DKokkos_ENABLE_TESTS=OFF \
    -DKokkos_ENABLE_EXAMPLES=OFF
  cmake --build "$KOKKOS_BUILD" -j "$JOBS"
  cmake --install "$KOKKOS_BUILD"
fi

mkdir -p "$KOKKOS_CUDA_ROOT/bin"
cp -f "$KOKKOS_SRC/bin/nvcc_wrapper" "$KOKKOS_CUDA_ROOT/bin/nvcc_wrapper"
chmod +x "$KOKKOS_CUDA_ROOT/bin/nvcc_wrapper"
export KOKKOS_ROOT="$KOKKOS_CUDA_ROOT"

echo "== configure saturnCFD CUDA =="
cmake -S "$REPO" -B "$BUILD_GPU" \
  -DCMAKE_TOOLCHAIN_FILE="$REPO/cmake/toolchains/cuda-kokkos.cmake" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_CXX_STANDARD=20 \
  -DMPI_C_COMPILER="$MPI_C_COMPILER" \
  -DMPI_CXX_COMPILER="$MPI_CXX_COMPILER" \
  -DSATURN_ENABLE_MPI=ON \
  -DSATURN_ENABLE_KOKKOS=ON \
  -DSATURN_BACKEND=cuda \
  -DSATURN_USE_SYSTEM_KOKKOS=ON \
  -DKokkos_ROOT="$KOKKOS_CUDA_ROOT" \
  -DSATURN_ENABLE_PETSC=OFF \
  -DSATURN_BUILD_TESTS=OFF \
  -DSATURN_BUILD_DOCS=OFF

echo "== build saturnCFD CUDA =="
cmake --build "$BUILD_GPU" -j "$JOBS"

echo
echo "GPU binary: $BUILD_GPU/saturnCFD"
echo "Kokkos    : $KOKKOS_CUDA_ROOT"
