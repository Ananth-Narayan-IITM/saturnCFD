#!/bin/bash
# Submit the CPU Heat scaling chain. Jobs run one after another through Slurm
# dependencies, so timings are not disturbed by this campaign's other jobs.

set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"
mkdir -p logs results
BIN="${BIN:-$HERE/../../buildCPUHPC/saturnCFD}"
if [ ! -x "$BIN" ]; then
  echo "error: missing binary $BIN"
  echo "       run ./cpuBuild or ./gpuBuild first"
  exit 1
fi

waitForJob() {
  local jid="$1"
  if [ "${WAIT:-1}" = "0" ]; then
    return 0
  fi
  while squeue -h -j "$jid" | grep -q .; do
    sleep 20
  done
}

runJob() {
  local script="$1" partition="$2" nodes="$3" ntasks="$4" cpus="$5"
  local case="$6" name="$7" extra="${8:-}"
  local out jid
  out=$(sbatch --parsable --partition="$partition" --nodes="$nodes" \
    --ntasks="$ntasks" --cpus-per-task="$cpus" --time=04:00:00 \
    --job-name="$name" --exclusive \
    --export="ALL,CASE=${case}" $extra "$script")
  jid="${out%%;*}"
  if [[ ! "$jid" =~ ^[0-9]+$ ]]; then
    echo "error: sbatch failed for $name: $out"
    exit 1
  fi
  echo "submitted $name  job=$jid"
  waitForJob "$jid"
  state="$(sacct -j "$jid" --format=State -n 2>/dev/null | head -n1 | tr -d ' ')"
  if [ -n "$state" ]; then
    echo "  state=$state"
    case "$state" in
      FAILED*|CANCELLED*|TIMEOUT*|NODE_FAIL*)
        echo "error: $name failed; inspect logs/${script}-${jid}.out"
        exit 1
        ;;
    esac
  fi
}

echo "CPU campaign finished"
echo "collect with: python3 collectResults.py"
