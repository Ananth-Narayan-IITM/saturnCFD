#!/bin/bash
# Submit the GPU Heat scaling chain (NVIDIA A100).
#
# Jobs are submitted one at a time and the script waits for each one: the
# cluster allows one running GPU job per user.
#
#   ./submitGpu                 full chain (waits for every job)
#   DRY_RUN=1 ./submitGpu       print the sbatch commands, submit nothing
#   WAIT=0 ./submitGpu          queue everything without waiting
#
# Run it in tmux/nohup: it stays in the foreground by design.

set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"
mkdir -p logs results/gpu

BIN="${BIN:-$HERE/../../buildGPUHPC/saturnCFD}"
if [ ! -x "$BIN" ]; then
  echo "error: missing binary $BIN"
  echo "       run ./gpuBuild first, then ./writeRuntime gpu"
  exit 1
fi

logFor() {
  local jid="$1"
  ls -t logs/*"$jid"*.out 2>/dev/null | head -n1
}

waitForJob() {
  local jid="$1"
  if [ "${WAIT:-1}" = "0" ]; then
    return 0
  fi
  while squeue -h -j "$jid" 2>/dev/null | grep -q .; do
    sleep 20
  done
}

jobState() {
  local jid="$1" state=""
  if [ "${WAIT:-1}" = "0" ]; then
    echo ""
    return 0
  fi
  for _ in 1 2 3 4 5 6; do
    state="$(sacct -j "$jid" --format=State -n 2>/dev/null |
      awk 'NF{print $1; exit}' || true)"
    [ -n "$state" ] && break
    sleep 5
  done
  echo "$state"
}

checkCase() {
  local case="$1"
  if [ ! -f "$HERE/cases/${case}.yaml" ]; then
    echo "error: missing case $HERE/cases/${case}.yaml"
    echo "       run: python3 generateCases.py"
    exit 1
  fi
}

# runGpu <script> <gpus> <case> <job name>
runGpu() {
  local script="$1" gpus="$2" case="$3" name="$4"
  local partition nodes pernode out jid state log
  checkCase "$case"
  if [ "$gpus" -eq 1 ]; then
    partition=sgpu
    nodes=1
    pernode=1
  else
    partition=gpu
    nodes=$(( gpus / 2 ))
    pernode=2
  fi
  if [ "${DRY_RUN:-0}" = "1" ]; then
    printf 'sbatch -p %s -N %d -n %d --ntasks-per-node=%d -c 4 --gpus-per-task=1' \
      "$partition" "$nodes" "$gpus" "$pernode"
    printf ' --export=ALL,CASE=%s,GPUS_PER_NODE=%d,SATURN_HPC_DIR=%s %s\n' \
      "$case" "$pernode" "$HERE" "$script"
    return 0
  fi
  out=$(sbatch --parsable --partition="$partition" --nodes="$nodes" \
    --ntasks="$gpus" --ntasks-per-node="$pernode" \
    --cpus-per-task=4 --time=04:00:00 \
    --job-name="$name" --exclusive --gpus-per-task=1 \
    --export="ALL,CASE=${case},GPUS_PER_NODE=${pernode},SATURN_HPC_DIR=${HERE}" \
    "$script")
  jid="${out%%;*}"
  if [[ ! "$jid" =~ ^[0-9]+$ ]]; then
    echo "error: sbatch failed for $name: $out"
    exit 1
  fi
  echo "submitted $name  case=$case  gpus=$gpus  job=$jid"
  waitForJob "$jid"
  state="$(jobState "$jid")"
  if [ -n "$state" ]; then
    echo "  state=$state"
    case "$state" in
      FAILED*|CANCELLED*|TIMEOUT*|NODE_FAIL*|OUT_OF_MEMORY*)
        log="$(logFor "$jid")"
        echo "error: $name failed; log: ${log:-none}"
        [ -n "$log" ] && tail -n 40 "$log"
        exit 1
        ;;
    esac
    log="$(logFor "$jid")"
    [ -n "$log" ] && echo "  log=$log"
  fi
}

echo "GPU campaign from $HERE"
echo "binary: $BIN"

echo
echo "== smoke test: 64^3 on one A100 =="
runGpu gpuStrong 1 heatStrong64 heatGpu1x64

echo
echo "== one A100 vs one node =="
runGpu gpuStrong 1 heatStrong128 heatGpu1x128

echo
echo "== multi-GPU strong scaling, 128^3 =="
runGpu gpuStrong 2 heatStrong128 heatGpu2x128
runGpu gpuStrong 4 heatStrong128 heatGpu4x128
runGpu gpuStrong 8 heatStrong128 heatGpu8x128

echo
echo "== dense, 256^3 on 8 A100 =="
runGpu gpuStrong 8 heatStrong256 heatGpu8x256

echo
echo "== weak scaling, 32^3 per GPU, 100 fixed steps =="
# Only 1 and 8 GPUs give a cubic mesh with exactly 32^3 cells per GPU
# (32^3, 64^3/8 = 32^3). 2 and 4 GPUs have no integer cube.
runGpu gpuWeak 1 heatWeak032 heatGpuWeak1x032
runGpu gpuWeak 8 heatWeak064 heatGpuWeak8x064

echo
echo "GPU campaign finished"
echo "collect with: python3 collectResults.py && python3 plotScaling.py"
