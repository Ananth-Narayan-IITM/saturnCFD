#!/bin/bash
# Capture the working login-node environment for compute-node batch jobs.
# Usage: ./writeRuntime cpu|gpu

set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
  cpu) source "$HERE/envCpu"; out="$HERE/envCpuRuntime" ;;
  gpu) source "$HERE/envGpu"; out="$HERE/envGpuRuntime" ;;
  *) echo "usage: $0 cpu|gpu"; exit 2 ;;
esac

# Capture PATH/LD_LIBRARY_PATH/compilers, but drop:
#  - shell bookkeeping and exported functions;
#  - the login node's Lmod state, which does not exist on the compute nodes
#    (BASH_ENV would point bash at a missing init script);
#  - per-job OpenMP placement, which must not leak from whatever shell the
#    capture ran in (cpuThreads sets these itself).
{
  echo "# generated by ./writeRuntime $1 on $(hostname) at $(date -Is)"
  export -p \
    | grep -vE 'BASH_FUNC|declare -x (_|PWD|OLDPWD|SHLVL)(=|$)' \
    | grep -vE '^declare -x (BASH_ENV|FPATH|LMOD_[A-Za-z_0-9]*|MODULEPATH|MODULESHOME|LOADEDMODULES|_LMFILES_|_ModuleTable[0-9A-Za-z_]*|__LMOD_[A-Za-z_0-9]*|which_declare|OMP_PROC_BIND|OMP_PLACES|OMP_DYNAMIC|OMP_THREAD_LIMIT)='
} > "$out"

if ! grep -q '^declare -x PATH=' "$out"; then
  echo "error: $out has no PATH" >&2
  exit 1
fi
echo "wrote $out"
