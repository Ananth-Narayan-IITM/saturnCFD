#!/bin/bash
# CPU environment for the Heat scaling campaign.
# Source this file from the job/build scripts: source ./envCpu

set -euo pipefail

# A batch shell inherits the login node's module function and LMOD_CMD. If
# that path is not present on the compute node, reinitialize Lmod.
module_ok=false
if [ -n "${LMOD_CMD:-}" ] && [ -x "${LMOD_CMD}" ]; then
  module_ok=true
fi
if [ "${module_ok}" = false ]; then
  unset -f module 2>/dev/null || true
  unset LMOD_CMD LMOD_DIR LMOD_PKG LMOD_ROOT LMOD_SETTARG_CMD MODULESHOME 2>/dev/null || true
  for init in /etc/profile.d/lmod.sh /etc/profile.d/modules.sh \
              /usr/share/lmod/lmod/init/bash \
              /opt/ohpc/admin/lmod/lmod/init/bash; do
    if [ -r "$init" ]; then
      # shellcheck disable=SC1090
      . "$init" && break
    fi
  done
fi
if [ -d /home/apps/modulefiles ]; then
  module use /home/apps/modulefiles 2>/dev/null || true
fi

module purge
if [ -d /home/apps/modulefiles ]; then
  module use /home/apps/modulefiles 2>/dev/null || true
fi
module load compiler/gcc/12.4
module load compiler/openmpi/5.0.6
module load python/3.12 2>/dev/null || true
command -v mpirun >/dev/null || {
  echo "error: mpirun missing after loading compiler/openmpi/5.0.6"
  module list 2>&1 || true
  exit 1
}

export PATH="$HOME/.local/bin:$PATH"
if [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/bin/cmake" ]; then
  export PATH="$CONDA_PREFIX/bin:$PATH"
fi

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OMP_PROC_BIND="${OMP_PROC_BIND:-close}"
export OMP_PLACES="${OMP_PLACES:-cores}"

export KOKKOS_CPU_ROOT="${KOKKOS_CPU_ROOT:-$HOME/.local/kokkos-cpu-4.7.04}"
export LD_LIBRARY_PATH="$KOKKOS_CPU_ROOT/lib64:$KOKKOS_CPU_ROOT/lib:${LD_LIBRARY_PATH:-}"

export CC="$(command -v gcc)"
export CXX="$(command -v g++)"
export MPI_C_COMPILER="$(command -v mpicc)"
export MPI_CXX_COMPILER="$(command -v mpicxx)"
