{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU (OpenMP) release build with tests and docs",
      "binaryDir": "${sourceDir}/buildCPU",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SATURN_BUILD_TESTS": "ON",
        "SATURN_BUILD_DOCS": "ON",
        "SATURN_ENABLE_KOKKOS": "ON",
        "SATURN_BACKEND": "openmp",
        "SATURN_USE_SYSTEM_KOKKOS": "OFF",
        "SATURN_ENABLE_PETSC": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "cpu",
      "displayName": "Default CPU (OpenMP) release build"
    },
    {
      "name": "gpu",
      "displayName": "GPU (CUDA) release build; requires KOKKOS_ROOT",
      "binaryDir": "${sourceDir}/buildGPU",
      "toolchainFile": "${sourceDir}/cmake/toolchains/cuda-kokkos.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SATURN_BUILD_TESTS": "ON",
        "SATURN_BUILD_DOCS": "OFF",
        "SATURN_ENABLE_KOKKOS": "ON",
        "SATURN_BACKEND": "cuda",
        "SATURN_USE_SYSTEM_KOKKOS": "ON",
        "SATURN_ENABLE_PETSC": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "cpu",
      "configurePreset": "cpu"
    },
    {
      "name": "gpu",
      "configurePreset": "gpu"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "regression",
      "displayName": "Regression tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "regression"
        }
      }
    },
    {
      "name": "unit",
      "displayName": "Unit tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "mesh",
      "displayName": "Mesh tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "mesh"
        }
      }
    },
    {
      "name": "config",
      "displayName": "Configuration tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "config"
        }
      }
    },
    {
      "name": "cli",
      "displayName": "CLI tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "cli"
        }
      }
    },
    {
      "name": "mpi",
      "displayName": "MPI tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "mpi"
        }
      }
    },
    {
      "name": "petsc",
      "displayName": "PETSc linear algebra tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "petsc"
        }
      }
    },
    {
      "name": "fv",
      "displayName": "Finite-volume and MMS tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "fv"
        }
      }
    },
    {
      "name": "gpu",
      "displayName": "GPU tests in buildGPU",
      "configurePreset": "gpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    }
  ]
}
