{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU (OpenMP) release build with tests and docs",
      "binaryDir": "${sourceDir}/buildCPU",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SATURN_BUILD_TESTS": "ON",
        "SATURN_BUILD_DOCS": "ON",
        "SATURN_ENABLE_KOKKOS": "ON",
        "SATURN_BACKEND": "openmp",
        "SATURN_USE_SYSTEM_KOKKOS": "OFF",
        "SATURN_ENABLE_PETSC": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "cpu",
      "displayName": "Default CPU (OpenMP) release build"
    },
    {
      "name": "gpu",
      "displayName": "GPU (CUDA) release build; requires KOKKOS_ROOT",
      "binaryDir": "${sourceDir}/buildGPU",
      "toolchainFile": "${sourceDir}/cmake/toolchains/cuda-kokkos.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SATURN_BUILD_TESTS": "ON",
        "SATURN_BUILD_DOCS": "OFF",
        "SATURN_ENABLE_KOKKOS": "ON",
        "SATURN_BACKEND": "cuda",
        "SATURN_USE_SYSTEM_KOKKOS": "ON",
        "SATURN_ENABLE_PETSC": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "cpu",
      "configurePreset": "cpu"
    },
    {
      "name": "gpu",
      "configurePreset": "gpu"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "displayName": "All tests (CPU build, or the active preset)",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu",
      "displayName": "CPU tests: everything except GPU-labelled tests",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      }
    },
    {
      "name": "solver",
      "displayName": "Solver numerics: FV operators, Burgers and heat",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "solver"
        }
      }
    },
    {
      "name": "saturnCFD",
      "displayName": "saturnCFD basics: CLI, config, mesh, PETSc, VTK, checkpoint",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "saturnCFD"
        }
      }
    },
    {
      "name": "gpu",
      "displayName": "GPU tests in buildGPU",
      "configurePreset": "gpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "gpu"
        }
      }
    }
  ]
}
